rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/demo/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid && id == 'state';
      allow create, update: if request.auth != null && request.auth.uid == uid && id == 'state'
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt', 'version'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 700000
        && request.resource.data.version == 1
        && request.resource.data.updatedAt == request.time;
    }
  }
}
